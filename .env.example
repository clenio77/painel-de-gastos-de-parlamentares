# Copie para .env (nunca commitar)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_PROJECT_REF=your_ref
# Senha do banco (Settings → Database) — necessária para aplicar SQL via psql
SUPABASE_DB_PASSWORD=your_db_password
# Região do pooler (veja em Connect → Session mode)
SUPABASE_POOLER_HOST=aws-0-sa-east-1.pooler.supabase.com
ETL_MONTHS=6
SQLITE_PATH=candidatos.db
