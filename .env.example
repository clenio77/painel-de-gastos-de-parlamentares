# Copie para .env (nunca commitar)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_PROJECT_REF=your_ref
# Senha do banco (Settings → Database) — necessária para aplicar SQL via psql
SUPABASE_DB_PASSWORD=your_db_password
# Região do pooler (veja em Connect → Session mode)
SUPABASE_POOLER_HOST=aws-1-sa-east-1.pooler.supabase.com

# Janela de coleta (prioridade: ETL_PERIODS > ETL_YEARS > ETL_FROM/ETL_TO > ETL_MONTHS)
ETL_MONTHS=6
# Exemplos para histórico:
# ETL_YEARS=2025
# ETL_FROM=2025-01
# ETL_TO=2025-12
# ETL_PERIODS=2025-01:2025-12

SQLITE_PATH=candidatos.db
